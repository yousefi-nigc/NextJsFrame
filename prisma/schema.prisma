// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. AUTHENTICATION MODELS (Your Existing)
// ==========================================

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?

  sessions Session[]
  accounts Account[]

  // --- NEW: Relation to Engineering Projects ---
  projects Project[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

// ==========================================
// 2. ENGINEERING MODELS (Project -> Floor -> Calc)
// ==========================================

model Project {
  id          String   @id @default(uuid())
  name        String
  address     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relation to User
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  floors Floor[]

  @@map("project")
}

model Floor {
  id          String  @id @default(uuid())
  name        String // e.g., "2nd Floor", "Basement"
  level       Float // Corresponds to input 'E' (e.g., 0, 1, 1.5)
  description String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // One-to-One relation with the calculation data
  assessment Assessment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("floor")
}

model Assessment {
  id      String @id @default(uuid())
  floorId String @unique
  floor   Floor  @relation(fields: [floorId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  // Relations to domain tables
  riskFactors      AssessmentRiskFactors?
  acceptanceFactors AssessmentAcceptanceFactors?
  protectionFactors AssessmentProtectionFactors?
  finalRisks       AssessmentFinalRisks?

  @@map("assessment")
}

// --- SECTION 2: CALCULATED FACTORS ---

model AssessmentRiskFactors {
  id          String @id @default(uuid())
  assessmentId String @unique
  assessment  Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  // Input Fields for Q/I/G/E/V/Z calculations
  // Fire load
  qi              Float? // Fire Load Fixed (MJ/m2)
  qm              Float? // Fire Load Mobile (MJ/m2)
  
  // Temperature/material
  tempDestruction Float? // T (Degrees C)
  tempDestructionMulti String? // JSON string of selected T rows with percents
  avgDimension    Float? // m (Meters)
  materialClass   Float? // M (0 to 5)
  materialClassMulti String? // JSON string of selected M rows with percents

  // Geometry
  length     Float? // l
  width      Float? // b
  area       Float? // A (Can be calc or input)
  height     Float? // h
  accessType String? // "wide" or "narrow"

  // Venting
  windowArea     Float? // Aw
  staticVentArea Float? // As
  mechVentFlow   Float? // Nm3/h
  ventingRatio_k Float? // k

  // Access Factors
  accessSides Int? // Z (1-4)
  heightAbove Float? // H+
  depthBelow  Float? // H-

  // Floor level for e calculation
  floorLevel Float? // E (can be negative for basements)

  // Calculated Risk Factors
  factor_q Float?
  factor_i Float?
  factor_g Float?
  factor_e Float?
  factor_v Float?
  factor_z Float?

  // Calculated Potential Risks
  risk_P  Float? // Building
  risk_P1 Float? // People
  risk_P2 Float? // Activities

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("assessment_risk_factors")
}

model AssessmentAcceptanceFactors {
  id          String @id @default(uuid())
  assessmentId String @unique
  assessment  Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  // Input Fields for A/T/C/R/D calculations
  // Activation factors
  mainActivity         Float? // Activation factor - main activity
  mainActivityKey      String? // Key for select display (e.g., "A1", "A2", "B", "C", "D") to handle duplicate values
  secondaryActivity    Float? // N - Painting/Spraying/Coating (NOT included in factor_a calculation per feedback)
  heatTransferType     Float? // Activation factor - heat transfer type
  heatTransferTypeKey  String? // Key for select display (e.g., "E1", "E2", "E3") to handle duplicate values
  generatorLocation    Float? // Activation factor - generator location
  generatorLocationKey String? // Key for select display (e.g., "F0", "F1", "F2") to handle duplicate values
  energySource         Float? // Activation factor - energy source
  energySourceKey      String? // Key for select display (e.g., "G0", "G1", "G2", "G3") to handle duplicate values
  electricalSystem     Float? // Activation factor - electrical system
  flammableLiquids     Float? // Activation factor - flammable liquids
  combustibleDust      Float? // Activation factor - combustible dust
  combustibleDustKey   String? // Key for select display (e.g., "K0", "K1", "K2") to handle duplicate values
  weldingOperations    Float? // W - Welding operations (0 or 0.1)
  additionalCarpentryPlastic Float? // P - Additional carpentry or use of plastic (0 or 0.1)
  specialRisk          Float? // S - Special risk (0 or 0.1)

  // Evacuation time inputs
  occupantCount        Int? // X
  occupantFactor       Float? // Factor used to calc X
  occupantFactorKey    String? // Key for select display (e.g., "office", "medical") to handle duplicate values
  exitWidths           String? // Comma-separated exit widths in centimeters (e.g., "80, 80, 120")
  exitWidthTotal       Float? // K (calculated from exitWidths if not provided)
  exitUnitsX           Float? // Manual x input (exit units) - takes priority over calculated x
  separatePathsK       Float? // Manual K input (separate paths) - takes priority over calculated K
  mobilityFactor       Float? // p
  exitCountToOpenSpace Int? // O - Number of exits leading to open space

  // Value factor inputs
  valueTotal       Float? // In Rials
  valueYear        Int?
  replaceability   Float? // c1

  // Dependency factor inputs
  dependencyType   String? // Category code
  dependencyManual Float? // d (manual override)

  // Calculated Acceptance Factors
  factor_a Float?
  factor_t Float?
  factor_c Float?
  factor_r Float?
  factor_d Float?

  // Calculated Acceptable Levels
  level_A  Float?
  level_A1 Float?
  level_A2 Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("assessment_acceptance_factors")
}

model AssessmentProtectionFactors {
  id          String @id @default(uuid())
  assessmentId String @unique
  assessment  Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  // Input Fields for W/N/S/F/U/Y calculations
  // Water supply (W)
  waterStorageType    String? // w1 logic ("auto", "manual", "none")
  waterCapacity       Float? // w2 logic (m³)
  distributionNetwork String? // w3 logic ("adequate", "limited", "none")
  hydrantCount25      Int?
  hydrantCount3       Int?
  hydrantCount4       Int?

  // Detection/Sprinkler (N/S)
  detectionType     Float? // s1
  sprinklerType     Float? // s3
  fireStationType   Float? // s4
  waterSupplyType   Float? // s2
  industrialBrigade Float? // s5
  n1 Float? // Detection and alarm
  n2 Float? // Manual extinguishers
  n3 Float? // Fire hydrant boxes
  n4 Float? // Fire station arrival time
  n5 Float? // Occupant training

  // Structure resistance (F)
  structureResist       Float? // fs (minutes)
  facadeResist          Float? // ff (minutes)
  roofResist            Float? // fd (minutes)
  wallResist            Float? // fw (minutes)
  hasManyWindows        Boolean? // Special condition for ff
  noInternalSeparation  Boolean? // Special condition for fw
  combustibleInsulation Boolean? // Special condition for fd

  // Evacuation (U)
  subcompartment Float? // Subcompartment type (0, 2, 4)
  stairways      Float? // Stairway type (0-8)
  horizontalExit Float? // Horizontal exit (0, 2, 8)
  sprinklers     Float? // Sprinkler protection (0, 5, 10)

  // Business continuity (Y)
  subCompartmentEI30   Boolean? // EI30 subcompartment
  subCompartmentEI60   Boolean? // EI60 subcompartment
  partialDetection     Boolean? // Partial detection system
  partialSprinkler     Boolean? // Partial sprinkler system
  otherAutoExtinguish  Boolean? // Other auto extinguishing systems
  financialDataBackup  Boolean? // Financial data backup
  sparePartsAccess     Boolean? // Spare parts access
  selfRepairCapability Boolean? // Self repair capability
  relocationAgreements Boolean? // Relocation agreements
  multipleProduction   Boolean? // Multiple production sites

  // Calculated Protection Factors
  factor_W Float?
  factor_N Float?
  factor_S Float?
  factor_F Float?
  factor_U Float?
  factor_Y Float?

  // Calculated Protection Levels
  level_D  Float?
  level_D1 Float?
  level_D2 Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("assessment_protection_factors")
}

// --- SECTION 3: FINAL SCORES ---

model AssessmentFinalRisks {
  id          String @id @default(uuid())
  assessmentId String @unique
  assessment  Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  // Initial Risk (Ro)
  factor_Fo Float?
  risk_Ro   Float?

  // Final Risks (R = P / (A * D))
  final_R  Float? // Building Risk
  final_R1 Float? // People Risk
  final_R2 Float? // Activities Risk

  // Status Strings (e.g., "Acceptable", "Critical")
  status_R  String?
  status_R1 String?
  status_R2 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("assessment_final_risks")
}
